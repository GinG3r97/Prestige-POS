# Supabase project credentials.
# Copy this file to `.env` and fill in the values from
# https://supabase.com/dashboard/project/<ref>/settings/api
#
# These two values are safe to ship in a mobile binary (the anon key is
# scoped by Row Level Security), but we still load them from `.env` so they
# don't sit in source control and can be rotated without a code change.

SUPABASE_URL=https://rgbzurrtjjoyqhnqyjwj.supabase.co
SUPABASE_ANON_KEY=paste-your-anon-key-here

# Must match the OTP length configured in Supabase Dashboard → Authentication
# → Providers → Email → "Email OTP length". 6 is the default; 8 is more secure.
SUPABASE_OTP_LENGTH=8
